# Copy to .env and fill in. .env is gitignored.
# Agent mode is Entra-only: run `az login` first. No API keys.

# --- Foundry resource / project ---------------------------------------------
# Voice Live WebSocket host. Use the services.ai.azure.com custom-domain form.
VOICELIVE_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/
# Foundry project endpoint, from the project welcome screen.
PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<project>
# Last path segment of PROJECT_ENDPOINT.
PROJECT_NAME=<project>

# --- Model deployments ------------------------------------------------------
# Chat deployment that becomes the agent's "brain" in Voice Live agent mode.
MODEL_DEPLOYMENT_NAME=gpt-5
# Realtime deployment used by the direct-model / BYOM track (Track B).
REALTIME_DEPLOYMENT_NAME=gpt-realtime-1.5

# --- Voice Live session -----------------------------------------------------
# API version. 2026-04-10 for direct/BYOM; agent-mode samples pin 2026-01-01-preview.
VOICELIVE_API_VERSION=2026-04-10
VOICELIVE_AGENT_API_VERSION=2026-01-01-preview
# Azure TTS voice. HD voices (":DragonHDLatestNeural") are not available in every region.
VOICE_NAME=en-US-AvaMultilingualNeural
VOICE_TYPE=azure-standard
# BYOM profile: byom-azure-openai-realtime | byom-azure-openai-chat-completion | byom-foundry-anthropic-messages
VOICELIVE_BYOM_MODE=byom-azure-openai-realtime
# Set only when the agent lives on a different Foundry resource than Voice Live.
FOUNDRY_RESOURCE_OVERRIDE=
AGENT_AUTHENTICATION_IDENTITY_CLIENT_ID=

# --- Agent ------------------------------------------------------------------
AGENT_NAME=rfp-voice-agent
# Optional: pin a version. Empty means latest.
AGENT_VERSION=
# Optional: resume a prior conversation.
CONVERSATION_ID=
# Populated by agent/setup_knowledge.py
VECTOR_STORE_ID=

# --- MCP --------------------------------------------------------------------
MCP_SERVER_URL=https://learn.microsoft.com/api/mcp
MCP_SERVER_LABEL=mslearn
